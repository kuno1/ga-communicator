{
	"name": "ga-communicator",
	"version": "1.0.0",
	"description": "A PHP library to communicate with Google Analytics API.",
	"main": "index.js",
	"scripts": {
		"start": "wp-env start",
		"debug": "wp-env start --xdebug",
		"update": "wp-env start --update",
		"stop": "wp-env stop",
		"test": "wp-env run tests-cli ./wp-content/plugins/ga-communicator/vendor/bin/phpunit -c ./wp-content/plugins/ga-communicator/phpunit.xml.dist",
		"test:scoper": "wp-env run tests-cli ./wp-content/plugins/ga-communicator/vendor-prefixed/vendor/bin/phpunit -c ./wp-content/plugins/ga-communicator/phpunit.xml.dist",
		"env": "wp-env",
		"cli": "wp-env run cli wp",
		"cli:test": "wp-env run tests-cli wp",
		"lint": "npm run lint:js && npm run lint:css",
		"build:js": "grab-deps js assets/js dist/js",
		"build:css": "sass ./assets/scss/:./dist/css/ --style=compressed --source-map && postcss ./dist/css/*.css --use autoprefixer --replace --map",
		"dump": "grab-deps dump dist/js,dist/css",
		"package": "npm run build:css && npm run build:js && npm run dump",
		"lint:js": "wp-scripts lint-js assets/js",
		"lint:css": "wp-scripts lint-style \"assets/scss/**/*.scss\"",
		"format": "wp-scripts lint-js assets/js --fix && wp-scripts lint-style \"assets/scss/**/*.scss\" --fix"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kuno1/ga-communicator.git"
	},
	"keywords": [
		"wordpress"
	],
	"author": "Kunoichi INC",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/kuno1/ga-communicator/issues"
	},
	"homepage": "https://github.com/kuno1/ga-communicator#readme",
	"devDependencies": {
		"@kunoichi/grab-deps": "^3.3.0",
		"@wordpress/env": "^10.8.0",
		"@wordpress/scripts": "^37.2.0",
		"autoprefixer": "^10.7.0",
		"postcss": "^8.5.33",
		"postcss-cli": "^12.0.0",
		"sass": "^1.108.2"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	}
}
